APP_ENV=development
PORT=8080
DATABASE_URL=postgresql://bw_user:replace-me@127.0.0.1:5432/bw_compliance
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=https://your-domain.example
PUBLIC_APP_URL=https://your-domain.example

# Node runtime only. 0 is safest for direct exposure and ignores X-Forwarded-* headers.
# Set 1-3 only when that exact number of controlled reverse-proxy hops sits in front of Node.
TRUST_PROXY_HOPS=0

AUDIT_INTEGRITY_SECRET=replace-with-a-different-32-character-secret

# Destructive retention/deletion maintenance credential. Generate independently; never reuse SESSION_SECRET.
RETENTION_JOB_SECRET=replace-with-a-different-32-character-random-secret

# Cloudflare Turnstile protects public email/password registration. The site key is public; keep the secret server-side.
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
OPERATIONS_SECRET=replace-with-at-least-32-random-characters
AUTOMATION_SECRET=replace-with-a-different-32-character-random-secret
PLATFORM_ADMIN_EMAILS=admin@your-domain.example
PLATFORM_REGULATORY_REVIEWERS=reviewer@your-domain.example

OBJECT_STORE_ENDPOINT=https://replace.r2.cloudflarestorage.com
OBJECT_STORE_REGION=auto
OBJECT_STORE_BUCKET=bw-compliance-evidence
OBJECT_STORE_ACCESS_KEY_ID=replace-me
OBJECT_STORE_SECRET_ACCESS_KEY=replace-me

MALWARE_SCAN_REQUIRED=true
MALWARE_SCAN_WEBHOOK_URL=https://scanner.example/scan
MALWARE_SCAN_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
EVIDENCE_SCAN_API_URL=https://scanner.example/scan
EVIDENCE_SCAN_SECRET=replace-with-at-least-32-random-characters

PAYMENT_PROVIDER=dpo
PAYMENT_WEBHOOK_SECRET=replace-with-a-different-32-character-random-secret
BILLING_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
DPO_COMPANY_TOKEN=replace-me
DPO_SERVICE_TYPE=replace-me
DPO_API_URL=https://secure.3gdirectpay.com/API/v6/
DPO_VERIFY_API_URL=https://secure.3gdirectpay.com/API/v6/
DPO_ALLOWED_HOSTS=secure.3gdirectpay.com

RESEND_API_KEY=
EMAIL_FROM=Thebe Desk <no-reply@your-domain.example>

# Optional Meta WhatsApp Cloud API connector. Leave all values empty until the
# business number, utility templates, consent flow and signed webhook are ready.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_TEMPLATE_MAP_JSON={"obligation_due":{"name":"bw_obligation_due","language":"en_US"},"compliance_schedule_due":{"name":"bw_compliance_schedule_due","language":"en_US"},"daily_operations_summary_ready":{"name":"bw_daily_operations_summary_ready","language":"en_US"},"critical_business_risk":{"name":"bw_critical_business_risk","language":"en_US"},"control_assurance_stale":{"name":"bw_control_assurance_stale","language":"en_US"},"performance_intelligence_alert":{"name":"bw_performance_intelligence_alert","language":"en_US"}}

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/auth/oauth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=https://your-domain.example/api/auth/oauth/facebook/callback
FACEBOOK_GRAPH_VERSION=v26.0

# Thebe Live Voice — OpenAI Realtime GA (local/example default remains disabled)
# OPENAI_API_KEY must be configured as a server-side deployment secret. Never expose it to browser code.
THEBE_LIVE_VOICE_ENABLED=0
THEBE_LIVE_VOICE_MAX_STARTS_PER_HOUR=6
THEBE_LIVE_VOICE_MAX_USER_STARTS_PER_HOUR=4
THEBE_LIVE_VOICE_MAX_SESSION_SECONDS=600
THEBE_LIVE_VOICE_UPSTREAM_TIMEOUT_MS=12000
THEBE_LIVE_VOICE_FAILURE_CIRCUIT_THRESHOLD=3
OPENAI_API_KEY=
