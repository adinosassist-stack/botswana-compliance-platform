{"schema":2,"shard":10,"views":{"calendar":"\n    <div class=\"card\"><h2>Compliance calendar</h2><div class=\"muted small\">Deadlines include profile-derived tasks and general tax/company obligations. Confirm applicability before filing.</div><div id=\"calendarList\" style=\"margin-top:12px\"></div></div>\n  ","vault":"\n    <div class=\"grid g2\" id=\"vaultGrid\">\n      <div class=\"card\"><div class=\"between row\"><div><h2>Evidence library</h2><div class=\"muted small\">Secure files become usable proof only after an authenticated malware scan and approval.</div></div><button type=\"button\" class=\"btn alt\" data-bw-onclick=\"exportEvidencePack()\">Export evidence pack</button></div><div id=\"vaultList\" style=\"margin-top:12px\"></div></div>\n      <div class=\"card\" id=\"vaultAddCard\"><h2>Add evidence record</h2>\n        <div class=\"stack\">\n          <div><label for=\"evName\">Document/evidence name</label><input id=\"evName\" placeholder=\"e.g. Trade licence 2026\"></div>\n          <div><label for=\"evCat\">Category</label><select id=\"evCat\"><option>Corporate</option><option>Tax</option><option>Employment</option><option>Licensing</option><option>Data protection</option><option>Tender</option></select></div>\n          <div><label for=\"evDate\">Expiry / review date</label><input id=\"evDate\" type=\"date\"></div>\n          <div><label for=\"evFile\">Evidence file (optional, private storage)</label><input id=\"evFile\" type=\"file\" accept=\".pdf,.png,.jpg,.jpeg,.docx\"></div>\n          <button type=\"button\" class=\"btn\" data-bw-onclick=\"addEvidence()\">Save evidence</button>\n          <div class=\"muted small\">Launch build stores state server-side. If private object storage is configured, selected evidence files are uploaded with short-lived signed URLs; otherwise file upload fails closed and metadata can still be saved.</div>\n        </div>\n      </div>\n    </div>\n  ","expert":"\n    <div class=\"grid g3\">\n      <div class=\"card\"><div class=\"kpi\">Review queue</div><div id=\"reviewCount\" class=\"score\">0</div></div>\n      <div class=\"card\"><div class=\"kpi\">High-risk items</div><div id=\"highReviewCount\" class=\"score bad\">0</div></div>\n      <div class=\"card\"><div class=\"kpi\">Rules needing validation</div><div id=\"ruleValidationCount\" class=\"score warn\">0</div></div>\n    </div>\n    <div class=\"grid g2\" style=\"margin-top:16px\">\n      <div class=\"card\"><h2>Professional review queue</h2><div id=\"reviewQueue\"></div></div>\n      <div class=\"card\">\n        <h2>Add review request</h2>\n        <div class=\"stack\">\n          <div><label for=\"rvType\">Review type</label><select id=\"rvType\"><option>Employment</option><option>Tax</option><option>Corporate / CIPA</option><option>Licensing</option><option>Data protection</option><option>Tender</option></select></div>\n          <div><label for=\"rvIssue\">Issue</label><input id=\"rvIssue\" placeholder=\"What needs professional review?\"></div>\n          <div><label for=\"rvRisk\">Risk</label><select id=\"rvRisk\"><option>High</option><option>Medium</option><option>Low</option></select></div>\n          <div><label for=\"rvNote\">Internal note</label><textarea id=\"rvNote\" rows=\"4\" placeholder=\"Facts, uncertainty, or rule requiring validation\"></textarea></div>\n          <button type=\"button\" class=\"btn\" data-bw-onclick=\"addReviewRequest()\">Add to queue</button>\n        </div>\n      </div>\n    </div>\n  ","aiservices":"\n  <div class=\"grid g4\">\n    <div class=\"card\"><div class=\"kpi\">AI credits</div><div class=\"score\" id=\"aiCreditBalance\">—</div></div>\n    <div class=\"card\"><div class=\"kpi\">Monthly allowance</div><div class=\"score\" id=\"aiMonthlyAllowance\">—</div></div>\n    <div class=\"card\"><div class=\"kpi\">Lifetime used</div><div class=\"score\" id=\"aiLifetimeUsed\">—</div></div>\n    <div class=\"card\"><div class=\"kpi\">Low balance</div><div class=\"score\" id=\"aiLowBalance\">—</div></div>\n  </div>\n\n  <div class=\"copilot-shell\">\n    <div class=\"card copilot-compose\">\n      <div class=\"section-eyebrow\">Evidence-grounded workspace intelligence</div>\n      <h2 style=\"margin-top:5px\">Thebe AI</h2>\n      <p class=\"muted small\">Ask about current risks, next actions, management priorities or tender readiness. Answers use a bounded, tenant-scoped snapshot of this workspace.</p>\n      <div class=\"stack\">\n        <div><label for=\"aiAdvisorMode\">Analysis mode</label><select id=\"aiAdvisorMode\"><option value=\"ask\">Ask a workspace question</option><option value=\"next_actions\">Prioritise next actions</option><option value=\"explain_risk\">Explain highest risk</option><option value=\"management_brief\">Prepare management brief</option><option value=\"tender_readiness\">Review tender readiness</option></select></div>\n        <div><label for=\"aiAdvisorQuestion\">Question</label><textarea id=\"aiAdvisorQuestion\" maxlength=\"1000\" aria-describedby=\"aiAdvisorHelp\" placeholder=\"What needs management attention today?\"></textarea><div id=\"aiAdvisorHelp\" class=\"muted small\">Maximum 1,000 characters · 6 AI credits when Workers AI runs</div></div>\n      </div>\n      <div class=\"copilot-quick\" aria-label=\"Suggested questions\">\n        <button type=\"button\" class=\"btn alt\" data-bw-onclick=\"setAiAdvisorPrompt('next_actions','What needs management attention today?')\">Today’s priorities</button>\n        <button type=\"button\" class=\"btn alt\" data-bw-onclick=\"setAiAdvisorPrompt('explain_risk','Explain the highest current business-protection risk and the evidence behind it.')\">Explain highest risk</button>\n        <button type=\"button\" class=\"btn alt\" data-bw-onclick=\"setAiAdvisorPrompt('tender_readiness','Summarise our current tender readiness and the mandatory gaps to close.')\">Tender readiness</button>\n        <button type=\"button\" class=\"btn alt\" data-bw-onclick=\"setAiAdvisorPrompt('management_brief','Prepare a concise management brief from current workspace records.')\">Management brief</button>\n      </div>\n      <button type=\"button\" id=\"aiAdvisorButton\" class=\"btn\" data-bw-onclick=\"askAiAdvisor()\">Ask Thebe AI</button>\n      <div class=\"copilot-truth\" style=\"margin-top:13px\">Read-only management aid. When configured, your question and a bounded workspace snapshot are processed by Cloudflare Workers AI. It does not file, send, approve, decide employment matters or change workspace records.</div>\n    </div>\n    <div class=\"card copilot-response\" aria-live=\"polite\" aria-atomic=\"false\" id=\"aiAdvisorRegion\">\n      <div class=\"copilot-empty\" id=\"aiAdvisorOutput\"><div><b>Grounded answers, visible references</b><div class=\"small\" style=\"margin-top:6px\">The response will show confidence, suggested follow-up and the workspace or official-source references used.</div></div></div>\n    </div>\n  </div>\n\n  <div class=\"grid g4\" style=\"margin-top:16px\" aria-label=\"Thebe AI business intelligence scope\">\n    <div class=\"card\"><div class=\"section-eyebrow\">Financial picture</div><h3>Cash &amp; margin signals</h3><div class=\"muted small\">Use imported bookkeeping summaries and workspace activity to surface cash pressure, margin movement, collection risk and runway questions for management review.</div></div>\n    <div class=\"card\"><div class=\"section-eyebrow\">Decision Engine</div><h3>Compare next moves</h3><div class=\"muted small\">Frame operating choices as explicit assumptions, trade-offs and risks. Recommendations remain advisory and must be approved by an authorised workspace user.</div></div>\n    <div class=\"card\"><div class=\"section-eyebrow\">Business Model Engine</div><h3>Test economics</h3><div class=\"muted small\">Assess pricing, customer volume, recurring revenue and cost assumptions using the business facts available to the workspace.</div></div>\n    <div class=\"card\"><div class=\"section-eyebrow\">Benchmark Network</div><h3>Learn from patterns</h3><div class=\"muted small\">Designed for privacy-preserving comparison against aggregated peer patterns as sufficient anonymised data becomes available; no company record is exposed to another tenant.</div></div>\n  </div>\n\n  <div class=\"grid g2\" style=\"margin-top:16px\">\n    <div class=\"card\">\n      <h2>Thebe AI services</h2>\n      <div class=\"item\"><b>Tender document analysis</b><div class=\"muted small\">25 credits</div></div>\n      <div class=\"item\"><b>Regulatory impact analysis</b><div class=\"muted small\">12 credits</div></div>\n      <div class=\"item\"><b>Document review</b><div class=\"muted small\">10 credits</div></div>\n      <div class=\"item\"><b>Policy draft</b><div class=\"muted small\">8 credits</div></div>\n      <div class=\"item\"><b>Business pathway</b><div class=\"muted small\">6 credits</div></div>\n      <div class=\"item\"><b>Thebe AI workspace advisor</b><div class=\"muted small\">6 credits</div></div>\n    </div>\n    <div class=\"card\">\n      <h2>Credit wallet</h2>\n      <div id=\"aiCreditWalletBox\" class=\"muted small\">Loading AI credit wallet…</div>\n      <div class=\"notice\" style=\"margin-top:14px\"><b>Purchased credits are protected</b><div class=\"small\">Monthly plan grants add to the wallet; they do not reset the total balance or erase purchased credits.</div></div>\n    </div>\n  </div>\n\n  <div class=\"grid g2\" style=\"margin-top:16px\">\n    <div class=\"card\">\n      <h2>Buy AI credits</h2>\n      <div id=\"aiCreditPacks\" class=\"grid g3\"></div>\n    </div>\n    <div class=\"card\">\n      <h2>Recent credit activity</h2>\n      <div id=\"aiCreditHistory\" class=\"muted small\">No activity yet.</div>\n    </div>\n  </div>\n","evidenceintegrity":"\n  <div class=\"grid g4\">\n    <div class=\"card\"><div class=\"kpi\">Quarantined</div><div class=\"score\" id=\"evidenceQuarantined\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Scan clean</div><div class=\"score\" id=\"evidenceScanClean\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Approved</div><div class=\"score\" id=\"evidenceApproved\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Scan problems</div><div class=\"score bad\" id=\"evidenceScanProblems\">0</div></div>\n  </div>\n  <div class=\"card\" style=\"margin-top:16px\"><h2>Evidence Security</h2>\n    <div class=\"notice\"><b>Quarantine is not antivirus.</b><div class=\"small\">Files cannot be approved, linked, used in assurance/inspection/defense packs, or downloaded until a configured malware scanner returns an authenticated clean result.</div></div>\n    <div id=\"evidenceScannerStatus\" class=\"muted small\" style=\"margin-top:10px\"></div>\n    <div id=\"evidenceIntegrityList\" class=\"muted small\" style=\"margin-top:12px\">No evidence yet.</div>\n  </div>\n","controlcenter":"\n  <div class=\"grid g4\">\n    <div class=\"card\"><div class=\"kpi\">Controls passing</div><div class=\"score\" id=\"controlPassing\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Need attention</div><div class=\"score warn\" id=\"controlAttention\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Failed controls</div><div class=\"score bad\" id=\"controlFailed\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Evidence health</div><div class=\"score\" id=\"evidenceHealthScore\">—</div></div>\n  </div>\n  <div class=\"grid g2\" style=\"margin-top:16px\">\n    <div class=\"card\">\n      <div class=\"between row\"><div><div class=\"section-eyebrow\">Continuous assurance for operating SMEs</div><h2>Control Assurance</h2></div><button type=\"button\" class=\"btn alt\" data-bw-onclick=\"recalculateControlCenter()\">Recalculate</button></div>\n      <div class=\"notice\"><b>Controls unify the product.</b><div class=\"small\">A control can be supported by regulatory rules, industry controls, approved evidence and risk events. Operational controls do not become legal requirements unless an approved published rule says so.</div></div>\n      <div id=\"controlCenterList\" class=\"muted small\" style=\"margin-top:12px\">No controls calculated yet.</div>\n    </div>\n    <div class=\"card\">\n      <div class=\"section-eyebrow\">Continuous proof</div><h2>Evidence Health</h2>\n      <div id=\"evidenceHealthDetail\" class=\"muted small\">No evidence health snapshot yet.</div>\n      <hr style=\"margin:16px 0\">\n      <div class=\"section-eyebrow\">Regulatory impact</div><h2>Change Cases</h2>\n      <div id=\"regChangeList\" class=\"muted small\">No regulatory change cases.</div>\n    </div>\n  </div>\n  <div class=\"card\" style=\"margin-top:16px\">\n    <div class=\"between row\"><div><div class=\"section-eyebrow\">Issue management simplified for SMEs</div><h2>Remediation</h2></div><span class=\"badge\">Protect / Control / Partner</span></div>\n    <div id=\"remediationList\" class=\"muted small\">No remediation cases.</div>\n  </div>\n","protecthub":"\n    <div class=\"hub-hero\"><div><div class=\"section-eyebrow\">Protect</div><h2>Keep the business protected without learning the compliance engine.</h2><p class=\"muted\">Start with actions, deadlines and proof. Company records, licences, regulatory controls and specialist assurance remain available when you need them.</p></div><button class=\"btn alt\" type=\"button\" data-bw-onclick=\"openCommandPaletteWithQuery('protect')\">Find a protection tool</button></div>\n    <div class=\"outcome-grid\">\n      <button class=\"outcome-card\" type=\"button\" data-hub-target=\"obligations\" data-bw-onclick=\"showView('obligations')\"><span class=\"section-eyebrow\">Act</span><b>Compliance actions</b><span class=\"outcome-card-status\">See what needs attention, what is due and which rule facts still need confirmation.</span><span class=\"outcome-card-action\">Review protection work →</span></button>\n      <button class=\"outcome-card\" type=\"button\" data-hub-target=\"evidencehub\" data-bw-onclick=\"showView('evidencehub')\"><span class=\"section-eyebrow\">Prove</span><b>Documents &amp; proof</b><span class=\"outcome-card-status\">Keep evidence, documents and review status attached to the work they support.</span><span class=\"outcome-card-action\">Open documents & proof →</span></button>\n      <button class=\"outcome-card\" type=\"button\" data-hub-target=\"businesshub\" data-bw-onclick=\"showView('businesshub')\"><span class=\"section-eyebrow\">Company</span><b>Business records &amp; licences</b><span class=\"outcome-card-status\">Maintain company, tax, licence and readiness facts without crowding everyday navigation.</span><span class=\"outcome-card-action\">Open business records →</span></button>\n    </div>\n  "}}