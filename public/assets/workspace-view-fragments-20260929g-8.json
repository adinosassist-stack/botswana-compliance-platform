{"schema":2,"shard":8,"views":{"privacy":"\n    <div class=\"grid g3\">\n      <div class=\"card\"><div class=\"kpi\">Privacy readiness</div><div class=\"score warn\" id=\"privacyScore\">0</div></div>\n      <div class=\"card\"><div class=\"kpi\">Data activities</div><div class=\"score\" id=\"dataActivityCount\">0</div></div>\n      <div class=\"card\"><div class=\"kpi\">High-risk gaps</div><div class=\"score bad\" id=\"privacyGaps\">0</div></div>\n    </div>\n    <div class=\"grid g2\" style=\"margin-top:16px\">\n      <div class=\"card\">\n        <h2>Data-protection readiness</h2>\n        <div class=\"callout small\">Botswana's Data Protection Act No. 18 of 2024 commenced on 14 January 2025. Production architecture therefore treats employee/customer evidence as protected data: encrypted storage, scoped access, retention/deletion controls and audited access are mandatory design requirements. This module is intentionally a control checklist until the complete obligations are professionally mapped into the production ruleset.</div>\n        <div id=\"privacyChecklist\" style=\"margin-top:12px\"></div>\n      </div>\n      <div class=\"card\">\n        <h2>Processing activity register</h2>\n        <div class=\"stack\">\n          <div><label for=\"dpActivity\">Activity</label><input id=\"dpActivity\" placeholder=\"e.g. Employee payroll\"></div>\n          <div><label for=\"dpCategory\">Personal data category</label><input id=\"dpCategory\" placeholder=\"e.g. names, salary, contact details\"></div>\n          <div><label for=\"dpPurpose\">Purpose</label><input id=\"dpPurpose\" placeholder=\"Why the business uses this data\"></div>\n          <div><label for=\"dpAccess\">Who can access it?</label><input id=\"dpAccess\" placeholder=\"e.g. Finance manager\"></div>\n          <button type=\"button\" class=\"btn\" data-bw-onclick=\"addDataActivity()\">Add activity</button>\n        </div>\n        <div id=\"dataActivityList\" style=\"margin-top:12px\"></div>\n      </div>\n    </div>\n  ","documents":"\n    <div class=\"card\">\n      <h2>Controlled document workflows</h2>\n      <div class=\"grid g3\" id=\"docGrid\"></div>\n      <div class=\"notice\" style=\"margin-top:16px\">High-risk documents such as dismissals, settlements and complex deductions should be escalated for professional review before use.</div>\n    </div>\n  ","datadeletion":"\n  <div class=\"grid g3\">\n    <div class=\"card\"><div class=\"kpi\">Deletion status</div><div class=\"score\" id=\"deleteStatus\">—</div></div>\n    <div class=\"card\"><div class=\"kpi\">Attempts</div><div class=\"score\" id=\"deleteAttempts\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Legal holds</div><div class=\"score\" id=\"deleteHolds\">0</div></div>\n  </div>\n  <div class=\"grid g2\" style=\"margin-top:16px\">\n    <div class=\"card\"><h2>Account deletion</h2>\n      <div class=\"notice\"><b>Protected deletion workflow</b><div class=\"small\">Evidence storage is deleted first. Active legal holds block deletion. Sessions are invalidated only after storage cleanup succeeds.</div></div>\n      <button type=\"button\" class=\"btn danger\" style=\"margin-top:12px\" data-bw-onclick=\"requestDeletion()\">Request deletion</button>\n      <div id=\"deleteDetail\" class=\"muted small\" style=\"margin-top:12px\"></div>\n    </div>\n    <div class=\"card\"><h2>Legal holds</h2><div id=\"legalHoldList\" class=\"muted small\">No holds.</div></div>\n  </div>\n"}}