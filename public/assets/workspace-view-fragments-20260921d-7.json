{"schema":2,"shard":7,"views":{"publishing":"\n    <div class=\"grid g3\">\n      <div class=\"card\"><div class=\"kpi\">Executable rules</div><div id=\"pubLive\" class=\"score good\">0</div></div>\n      <div class=\"card\"><div class=\"kpi\">Review-gated rules</div><div id=\"pubReview\" class=\"score warn\">0</div></div>\n      <div class=\"card\"><div class=\"kpi\">Blocked by conflict</div><div id=\"pubBlocked\" class=\"score bad\">0</div></div>\n    </div>\n    <div class=\"card\" style=\"margin-top:16px\">\n      <div class=\"between row\"><div><h2>Legal rule publishing console</h2><div class=\"muted small\">Platform governance view. Publication authority is enforced server-side through platform roles and maker-checker controls.</div></div><span class=\"badge info\">Four-eye control target</span></div>\n      <div id=\"publishingList\" style=\"margin-top:12px\"></div>\n    </div>\n    <div class=\"card\" style=\"margin-top:16px\">\n      <h2>Publishing policy</h2>\n      <div class=\"timeline\">\n        <div class=\"item\"><b>1. Source captured</b><div class=\"muted small\">Primary legislation, Gazette, regulator page or official guidance is recorded.</div></div>\n        <div class=\"item\"><b>2. Effective date resolved</b><div class=\"muted small\">Commencement, amendment and transitional dates are identified.</div></div>\n        <div class=\"item\"><b>3. Applicability encoded</b><div class=\"muted small\">Business facts and thresholds are mapped to the rule.</div></div>\n        <div class=\"item\"><b>4. Professional review</b><div class=\"muted small\">Required for high-risk or legally interpretive controls.</div></div>\n        <div class=\"item\"><b>5. Test cases passed</b><div class=\"muted small\">Positive, negative, boundary and conflict cases are tested.</div></div>\n        <div class=\"item\"><b>6. Published / blocked</b><div class=\"muted small\">Conflicted rules remain blocked until resolved.</div></div>\n      </div>\n    </div>\n  ","audit":"\n    <div class=\"card\">\n      <div class=\"between row\"><div><h2>Audit log</h2><div class=\"muted small\">Server-authored audit history. v56+ events are integrity-chained; legacy entries remain explicitly unsealed.</div></div><button type=\"button\" class=\"btn alt\" data-bw-onclick=\"exportAudit()\">Export JSON</button></div>\n      <div id=\"auditList\" style=\"margin-top:12px\"></div>\n    </div>\n  ","accountdata":"\n    <div class=\"grid g2\">\n      <div class=\"card\">\n        <h2>Export your data</h2>\n        <div class=\"muted small\">Download a structured JSON export of your account, companies, evidence metadata, cases, reviews, social identities and audit history.</div>\n        <button type=\"button\" class=\"btn alt\" style=\"margin-top:14px\" data-bw-onclick=\"exportMyAccount()\">Download account export</button>\n      </div>\n      <div class=\"card\">\n        <h2>Delete account</h2>\n        <div class=\"rulebad small\">Deletion is queued for retention/legal-hold review instead of immediately destroying regulated business records.</div>\n        <div class=\"stack\" style=\"margin-top:12px\">\n          <div><label for=\"deleteAccountConfirmation\">Type DELETE MY ACCOUNT</label><input id=\"deleteAccountConfirmation\" autocomplete=\"off\"></div>\n          <button type=\"button\" class=\"btn danger\" data-bw-onclick=\"requestAccountDeletion()\">Request account deletion</button>\n          <div id=\"deletionStatusBox\" style=\"margin-top:10px\" aria-live=\"polite\"><div class=\"muted small\">Checking deletion and legal-hold status…</div></div>\n        </div>\n      </div>\n    </div>\n  ","tenderready":"\n  <div class=\"grid g4\">\n    <div class=\"card\"><div class=\"kpi\">Tender readiness</div><div class=\"score\" id=\"tenderReadinessScore\">—</div></div>\n    <div class=\"card\"><div class=\"kpi\">Tracked tenders</div><div class=\"score\" id=\"trackedTenderCount\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Mandatory ready</div