{"schema":2,"shard":2,"views":{"employmentcontrols":"\n    <div class=\"grid g3\">\n      <div class=\"card\"><div class=\"kpi\">Fixed-term contracts</div><div id=\"ftCount\" class=\"score\">0</div></div>\n      <div class=\"card\"><div class=\"kpi\">12+ month review flags</div><div id=\"ftFlags\" class=\"score warn\">0</div></div>\n      <div class=\"card\"><div class=\"kpi\">High-risk employment cases</div><div id=\"empHighRisk\" class=\"score bad\">0</div></div>\n    </div>\n    <div class=\"grid g2\" style=\"margin-top:16px\">\n      <div class=\"card\">\n        <h2>Contract-duration control</h2>\n        <div class=\"callout small\">Government's June 2026 explanation of the Employment and Labour Relations Act says fixed-term contracts are limited to 12 months unless objectively justified. This control flags contracts for review; it does not decide whether a particular justification is legally sufficient.</div>\n        <div id=\"fixedTermList\" style=\"margin-top:12px\"></div>\n      </div>\n      <div class=\"card\">\n        <h2>Add fixed-term contract metadata</h2>\n        <div class=\"stack\">\n          <div><label for=\"ftEmployee\">Employee / reference</label><input id=\"ftEmployee\"></div>\n          <div class=\"formgrid\">\n            <div><label for=\"ftStart\">Start date</label><input id=\"ftStart\" type=\"date\"></div>\n            <div><label for=\"ftEnd\">End date</label><input id=\"ftEnd\" type=\"date\"></div>\n          </div>\n          <div><label for=\"ftJustified\">Objective justification documented?</label><select id=\"ftJustified\"><option value=\"false\">No / not yet</option><option value=\"true\">Yes</option></select></div>\n          <button type=\"button\" class=\"btn\" data-bw-onclick=\"addFixedTerm()\">Add contract control</button>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"card\" style=\"margin-top:16px\">\n      <h2>High-risk termination guard</h2>\n      <div class=\"muted small\">This guard deliberately prevents the app from giving a one-click dismissal answer.</div>\n      <div class=\"formgrid\" style=\"margin-top:12px\">\n        <div><label for=\"termReason\">Reason category</label><select id=\"termReason\"><option>Poor performance</option><option>Misconduct</option><option>Absence / desertion</option><option>Operational requirements / redundancy</option><option>End of fixed term</option><option>Other</option></select></div>\n        <div><label for=\"termEvidence\">Evidence complete?</label><select id=\"termEvidence\"><option value=\"false\">No / uncertain</option><option value=\"true\">Yes</option></select></div>\n        <div><label for=\"termResponse\">Employee heard / response recorded?</label><select id=\"termResponse\"><option value=\"false\">No / uncertain</option><option value=\"true\">Yes</option></select></div>\n        <div><label for=\"termReview\">Professional review completed?</label><select id=\"termReview\"><option value=\"false\">No</option><option value=\"true\">Yes</option></select></div>\n      </div>\n      <div class=\"actions\" style=\"margin-top:12px\"><button type=\"button\" class=\"btn\" data-bw-onclick=\"runTerminationGuard()\">Assess readiness</button></div>\n      <div id=\"terminationGuardOutput\" style=\"margin-top:12px\"></div>\n    </div>\n  ","accountsocial":"\n    <div class=\"grid g3\">\n      <div class=\"card\"><div class=\"kpi\">Google</div><div id=\"googleLinkStatus\" style=\"font-size:22px;font-weight:800\">Checking…</div></div>\n      <div class=\"card\"><div class=\"kpi\">Facebook</div><div id=\"facebookLinkStatus\" style=\"font-size:22px;font-weight:800\">Checking…</div></div>\n      <div class=\"card\"><div class=\"kpi\">Sign-in security</div><div style=\"font-size:20px;font-weight:800\">Account-linked</div></div>\n    </div>\n    <div class=\"grid g2\" style=\"margin-top:16px\">\n      <div class=\"card\">\n        <h2>Social sign-in</h2>\n        <div id=\"socialAccountList\"></div>\n      </div>\n      <div class=\"card\">\n        <h2>How linking works</h2>\n        <div class=\"checkline\"><span class=\"dot good\"></span><div><b>Explicit linking</b><div class=\"muted small\">Facebook is never attached to an existing account by email match alone.</div></div></div>\n        <div class=\"checkline\"><span class=\"dot good\"></span><div><b>Provider secrets stay server-side</b><div class=\"muted small\">The browser receives no Google client secret or Facebook app secret.</div></div></div>\n        <div class=\"checkline\"><span class=\"dot good\"></span><div><b>Safe disconnect</b><div class=\"muted small\">The last usable sign-in method cannot be removed until another login method exists.</div></div></div>\n      </div>\n    </div>\n  ","workflowhub":"\n  <div class=\"grid g3\">\n    <div class=\"card\"><div class=\"kpi\">Automation rules</div><div class=\"score\" id=\"workflowRuleCount\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Enabled</div><div class=\"score\" id=\"workflowEnabledCount\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Queued jobs</div><div class=\"score\">0</div></div>\n  </div>\n  <div class=\"grid g2\" style=\"margin-top:16px\">\n    <div class=\"card\">\n      <h2>Create automation</h2>\n      <div class=\"stack\">\n        <div><label for=\"workflowTrigger\">Trigger</label><select id=\"workflowTrigger\"><option value=\"deadline\">Deadline approaching</option><option value=\"evidence-expiry\">Evidence expiring</option><option value=\"high-risk-hr\">High-risk HR case</option><option value=\"tender-closing\">Tender closing soon</option></select></div>\n        <div><label for=\"workflowAction\">Action</label><select id=\"workflowAction\"><option value=\"create-task\">Create task</option><option value=\"queue-review\">Queue review</option><option value=\"send-reminder\">Send reminder</option></select></div>\n        <button type=\"button\" class=\"btn\" data-bw-onclick=\"createWorkflowRule()\">Create automation</button>\n      </div>\n    </div>\n    <div class=\"card\">\n      <h2>Automation rules</h2>\n      <div id=\"workflowRuleList\" class=\"muted small\">No automation rules yet.</div>\n    </div>\n  </div>\n","entitlements":"\n  <div class=\"grid g4\">\n    <div class=\"card\"><div class=\"kpi\">Current plan</div><div class=\"score\" id=\"entitlementPlan\">—</div></div>\n    <div class=\"card\"><div class=\"kpi\">Enabled modules</div><div class=\"score\" id=\"entitlementEnabled\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Limited modules</div><div class=\"score\" id=\"entitlementLimited\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Overrides</div><div class=\"score\" id=\"entitlementOverrides\">0</div></div>\n  </div>\n  <div class=\"grid g2\" style=\"margin-top:16px\">\n    <div class=\"card\"><h2>Plan access</h2><div id=\"entitlementList\" class=\"muted small\">Loading plan access…</div></div>\n    <div class=\"card\"><h2>Usage</h2><div id=\"entitlementUsage\" class=\"muted small\">No usage yet.</div></div>\n  </div>\n","regulatoryintel":"\n  <div class=\"grid g4\">\n    <div class=\"card\"><div class=\"kpi\">Sources pending</div><div class=\"score\" id=\"regSourcesPending\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Rules in review</div><div class=\"score\" id=\"regRulesReview\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Published rules</div><div class=\"score\" id=\"regRulesPublished\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Open conflicts</div><div class=\"score\" id=\"regConflictsOpen\">0</div></div>\n  </div>\n  <div class=\"grid g2\" style=\"margin-top:16px\">\n    <div class=\"card\"><h2>Regulatory sources</h2><div id=\"regulatorySourceList\" class=\"muted small\">No sources loaded.</div></div>\n    <div class=\"card\"><h2>Rule publishing</h2><div id=\"regulatoryRuleList\" class=\"muted small\">No rules loaded.</div></div>\n  </div>\n  <div class=\"grid g2\" style=\"margin-top:16px\">\n    <div class=\"card\"><h2>Authority conflicts</h2><div id=\"regulatoryConflictList\" class=\"muted small\">No open conflicts.</div></div>\n    <div class=\"card\"><h2>Your regulatory impacts</h2><div id=\"regulatoryImpactList\" class=\"muted small\">No current impacts.</div></div>\n  </div>\n  <div class=\"notice\" style=\"margin-top:16px\"><b>Controlled publishing</b><div class=\"small\">A regulatory rule cannot be approved or published unless its sources are approved. Open authoritative-source conflicts block publication rather than forcing an automatic conclusion.</div></div>\n","controllineage":"\n  <div class=\"card\">\n    <div class=\"section-eyebrow\">Why is this control green or red?</div>\n    <h2>Control Lineage</h2>\n    <div class=\"muted small\">Trace a control to mapped rules, approved evidence, risk events, remediation, human reviews and continuous-assurance tests.</div>\n    <div class=\"row\" style=\"margin-top:12px\"><select id=\"lineageControlSelect\" aria-label=\"Lineage control select\"></select><button type=\"button\" class=\"btn alt\" data-bw-onclick=\"loadControlLineage()\">Trace control</button></div>\n    <div id=\"lineageDetail\" class=\"muted small\" style=\"margin-top:14px\">Choose a control.</div>\n  </div>\n"}}