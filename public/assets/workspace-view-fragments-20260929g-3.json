{"schema":2,"shard":3,"views":{"employer":"\n    <div class=\"hr-people-summary\"><div class=\"hr-people-stat\"><b id=\"employeeCount\">8</b><small>employees</small></div><div class=\"hr-evidence-stat\"><b id=\"employeeGaps\">3</b><small>missing evidence</small></div><div class=\"hr-risk-boundary\"><b>Review evidence</b><small>Workflow safeguards support human decisions; Thebe does not assign an employee risk score.</small></div></div>\n    <div class=\"grid g2\" style=\"margin-top:16px\">\n      <div class=\"card\">\n        <h2>Start protected workflow</h2>\n        <div class=\"protected-workflow-launch\"><select id=\"protectedWorkflowType\" aria-label=\"Protected workflow type\"><option value=\"\">Choose a workflow</option><option>Absence / AWOL</option><option>Poor performance</option><option>Misconduct</option><option>Asset damage/loss</option><option>Salary advance/deduction</option><option>Termination review</option></select><button type=\"button\" class=\"btn\" data-bw-onclick=\"startWorkflow(document.getElementById('protectedWorkflowType').value)\">Start workflow</button></div>\n        <div id=\"workflowOutput\" style=\"margin-top:14px\"></div>\n        <div style=\"margin-top:18px\">\n          <h3>Active HR cases</h3>\n          <div id=\"caseList\"></div>\n        </div>\n      </div>\n      <div class=\"card\"><h2>Employee file health</h2><div id=\"employeeFiles\"></div></div>\n    </div>\n  ","changes":"\n    <div class=\"card\"><h2>Law & regulatory change feed</h2><div id=\"lawChanges\"></div></div>\n  ","rules":"\n    <div class=\"card\">\n      <div class=\"between row\"><div><h2>Botswana rule library</h2><div class=\"muted small\">Structured, effective-date-aware controls. High-risk rules are locked for professional validation before production automation.</div></div><span class=\"badge info\">Ruleset BW-2026.08.30-launch</span></div>\n      <div id=\"ruleLibrary\" style=\"margin-top:12px\"></div>\n    </div>\n  ","billing":"\n    <div class=\"grid g4\">\n      <div class=\"card\"><div class=\"kpi\">Plan</div><div id=\"billingPlanName\" style=\"font-size:24px;font-weight:800\">Business</div></div>\n      <div class=\"card\"><div class=\"kpi\">Subscription status</div><div id=\"billingStatus\" style=\"font-size:24px;font-weight:800\">Trial</div></div>\n      <div class=\"card\"><div class=\"kpi\">Next billing date</div><div id=\"billingDate\" style=\"font-size:20px;font-weight:800\">—</div></div>\n      <div class=\"card\"><div class=\"kpi\">Billing</div><div style=\"font-size:20px;font-weight:800\">Manual bank transfer</div></div>\n    </div>\n    <div class=\"grid g2\" style=\"margin-top:16px\">\n      <div class=\"card\">\n        <h2>Plan & billing</h2>\n        <div class=\"muted small\">Choose the plan that fits your business. For Phase 0, subscription payment is by bank transfer to the Thebe Desk company account. A plan activates only after Thebe Desk verifies that the funds have reflected.</div>\n        <div class=\"row\" style=\"margin-top:14px\"><label style=\"min-width:170px\">Billing cycle<select id=\"billingCycleSelect\" aria-label=\"Billing cycle select\"><option value=\"monthly\">Monthly</option><option value=\"annual\">Annual · 2 months free</option></select></label></div><div class=\"grid g4\" style=\"margin-top:14px\">\n          <button type=\"button\" class=\"eventcard\" data-bw-onclick=\"requestPlan('starter')\"><b>Monitor</b><div class=\"muted small\">P149 / month</div></button>\n          <button type=\"button\" class=\"eventcard\" data-bw-onclick=\"requestPlan('business')\"><b>Protect</b><div class=\"muted small\">P349 / month</div></button>\n          <button type=\"button\" class=\"eventcard\" data-bw-onclick=\"requestPlan('pro')\"><b>Control</b><div class=\"muted small\">P699 / month</div></button>\n          <button type=\"button\" class=\"eventcard\" data-bw-onclick=\"requestPlan('network')\"><b>Network</b><div class=\"muted small\">P1,299 / month</div></button>\n        </div>\n        <div id=\"upgradeResult\" style=\"margin-top:14px\" role=\"status\" aria-live=\"polite\"></div>\n      </div>\n      <div class=\"card\">\n        <h2>Billing controls</h2>\n        <div class=\"checkline\"><span class=\"dot good\"></span><div><b>Manual verification</b><div class=\"muted small\">Proof or a submitted bank reference never activates a plan by itself. Thebe Desk must confirm reflected funds before activation.</div></div></div>\n        <div class=\"checkline\"><span class=\"dot good\"></span><div><b>Read access preserved</b><div class=\"muted small\">Past-due accounts can retain read access while writes are restricted according to subscription policy.</div></div></div>\n      </div>\n    </div>\n  ","companysecretary":"\n  <div class=\"grid g4\">\n    <div class=\"card\"><div class=\"kpi\">Open actions</div><div class=\"score\" id=\"companyOpenActions\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">In review</div><div class=\"score\" id=\"companyReviewActions\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Blocked</div><div class=\"score\" id=\"companyBlockedActions\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Due soon</div><div class=\"score\" id=\"companyDueSoon\">0</div></div>\n  </div>\n  <div class=\"grid g2\" style=\"margin-top:16px\">\n    <div class=\"card\">\n      <h2>Start company action</h2>\n      <div class=\"stack\">\n        <div><label for=\"companyActionType\">Action</label><select id=\"companyActionType\"><option value=\"annual-return\">Annual return</option><option value=\"beneficial-owner-change\">Beneficial owner change</option><option value=\"director-change\">Director change</option><option value=\"shareholder-change\">Shareholder change</option><option value=\"registered-office-change\">Registered office change</option><option value=\"constitution-review\">Constitution review</option></select></div>\n        <div><label for=\"companyActionDue\">Due date</label><input id=\"companyActionDue\" type=\"date\"></div>\n        <button type=\"button\" class=\"btn\" data-bw-onclick=\"createCompanyAction()\">Create action</button>\n      </div>\n    </div>\n    <div class=\"card\">\n      <h2>Company action register</h2>\n      <div id=\"companyActionList\" class=\"muted small\">No actions yet.</div>\n    </div>\n  </div>\n"}}