{"schema":2,"shard":9,"views":{"corporate":"\n    <div class=\"grid g3\">\n      <div class=\"card\"><div class=\"kpi\">Constitution</div><div id=\"corpConstitution\" style=\"font-size:22px;font-weight:800\">—</div></div>\n      <div class=\"card\"><div class=\"kpi\">Beneficial owner evidence</div><div id=\"corpBO\" style=\"font-size:22px;font-weight:800\">—</div></div>\n      <div class=\"card\"><div class=\"kpi\">Corporate change risk</div><div id=\"corpRisk\" style=\"font-size:22px;font-weight:800\">—</div></div>\n    </div>\n    <div class=\"grid g2\" style=\"margin-top:16px\">\n      <div class=\"card\">\n        <h2>Corporate change workflow</h2>\n        <div class=\"corporate-change-launch\"><select id=\"corporateChangeType\" aria-label=\"Corporate change type\"><option value=\"\">Choose a corporate change</option><option value=\"director\">Director changed</option><option value=\"shareholder\">Shareholder changed</option><option value=\"beneficial\">Beneficial owner changed</option><option value=\"office\">Registered office changed</option><option value=\"activity\">Business activity changed</option><option value=\"nominee\">Nominee/alternate arrangement</option></select><button type=\"button\" class=\"btn\" data-bw-onclick=\"runCorpChange(document.getElementById('corporateChangeType').value)\">Start change review</button></div>\n        <div id=\"corpChangeOutput\" style=\"margin-top:14px\"></div>\n      </div>\n      <div class=\"card\">\n        <h2>Corporate evidence</h2>\n        <div id=\"corpEvidence\"></div>\n        <div class=\"callout small\" style=\"margin-top:12px\">CIPA's 2025 OBRS upgrade requires constitutions for all companies and enhanced beneficial-owner declarations. Nominee or alternate directors/shareholders must also be declared where such arrangements exist.</div>\n      </div>\n    </div>\n    <div class=\"card\" id=\"cipaRegistryPanel\" style=\"margin-top:16px\"><details class=\"cipa-reconciliation-disclosure\"><summary><span><b>CIPA / OBRS reconciliation</b><small>Stage registry evidence and review profile drift</small></span><span id=\"cipaRegistryMode\" class=\"badge warn\">Manual evidence</span></summary><div class=\"cipa-reconciliation-inner\">\n      \n      <div class=\"notice\" style=\"margin-top:12px\"><b>No live CIPA sync is claimed.</b><div class=\"small\">Upload a current, approved and malware-cleared CIPA/OBRS extract or register-search record, then stage its normalized particulars. Differences never overwrite the workspace automatically; an owner must accept each registry value or record why the workspace value is retained.</div></div>\n      <div class=\"grid g3\" style=\"margin-top:12px\">\n        <div class=\"item\"><div class=\"kpi\">Current snapshot</div><b id=\"cipaSnapshotStatus\">Not staged</b></div>\n        <div class=\"item\"><div class=\"kpi\">Pending differences</div><b id=\"cipaPendingCount\">0</b></div>\n        <div class=\"item\"><div class=\"kpi\">Matched fields</div><b id=\"cipaMatchedCount\">0</b></div>\n      </div>\n      <div class=\"grid g2\" style=\"margin-top:14px\">\n        <div>\n          <h3>Stage current registry particulars</h3>\n          <div class=\"formgrid\">\n            <div><label for=\"cipaEvidenceId\">Approved CIPA evidence</label><select id=\"cipaEvidenceId\"><option value=\"\">Choose approved evidence</option></select></div>\n            <div><label for=\"cipaSourceType\">Source</label><select id=\"cipaSourceType\"><option value=\"obrs_company_extract\">OBRS company extract</option><option value=\"cipa_register_search\">CIPA register search record</option></select></div>\n            <div><label for=\"cipaObservedAt\">Source observed date</label><input id=\"cipaObservedAt\" type=\"date\"></div>\n            <div><label for=\"cipaRegistrationNumber\">CIPA UIN / registration number</label><input id=\"cipaRegistrationNumber\" maxlength=\"40\"></div>\n            <div><label for=\"cipaLegalName\">Registered legal name</label><input id=\"cipaLegalName\" maxlength=\"160\"></div>\n            <div><label for=\"cipaEntityType\">Entity type</label><select id=\"cipaEntityType\"><option value=\"company\">Company</option><option value=\"business_name\">Business name</option><option value=\"sole_trader\">Sole trader</option><option value=\"partnership\">Partnership</option><option value=\"other\">Other</option></select></div>\n            <div><label for=\"cipaRegistrationStatus\">Registry status</label><select id=\"cipaRegistrationStatus\"><option value=\"active\">Active</option><option value=\"registered\">Registered</option><option value=\"inactive\">Inactive</option><option value=\"deregistered\">Deregistered</option><option value=\"removed\">Removed</option><option value=\"unknown\">Unknown / needs review</option></select></div>\n            <div><label for=\"cipaRegistrationDate\">Registration date</label><input id=\"cipaRegistrationDate\" type=\"date\"></div>\n            <div><label for=\"cipaAnnualReturnMonth\">Annual-return month</label><select id=\"cipaAnnualReturnMonth\"><option value=\"\">Not shown / not applicable</option><option>January</option><option>February</option><option>March</option><option>April</option><option>May</option><option>June</option><option>July</option><option>August</option><option>September</option><option>October</option><option>November</option><option>December</option></select></div>\n            <div><label for=\"cipaRegisteredOffice\">Registered office</label><input id=\"cipaRegisteredOffice\" maxlength=\"240\"></div>\n          </div>\n          <label class=\"checkline\" style=\"margin-top:10px\"><input id=\"cipaReviewConfirmed\" type=\"checkbox\" aria-label=\"CIPA review confirmed\"><div><b>I reviewed these particulars against the attached current CIPA source.</b><div class=\"muted small\">The source observation must be no more than 31 days old.</div></div></label>\n          <div class=\"row\" style=\"margin-top:10px\"><button class=\"btn\" type=\"button\" data-bw-onclick=\"stageCipaRegistrySnapshot()\">Stage registry snapshot</button><span id=\"cipaRegistryStatus\" class=\"muted small\"></span></div>\n          <div class=\"row\" style=\"margin-top:10px\"><a class=\"btn soft\" href=\"https://www.cipa.co.bw/\" target=\"_blank\" rel=\"noopener noreferrer\">Open CIPA</a><a class=\"btn soft\" href=\"https://www.cipa.co.bw/master/ui/start/CIPARegisterSearch\" target=\"_blank\" rel=\"noopener noreferrer\">Search the CIPA register</a><button class=\"btn alt\" type=\"button\" data-bw-onclick=\"showView('vault')\">Add source evidence</button></div>\n        </div>\n        <div><h3>Profile drift review</h3><div id=\"cipaReconciliationList\" class=\"muted small\">No registry snapshot staged.</div></div>\n      </div>\n      <div class=\"source-note\" style=\"margin-top:12px\"><b>Source-of-truth rule:</b> CIPA/OBRS controls official registration particulars. The workspace controls internal operational records. Applying one registry field does not prove every CIPA filing is current and does not submit anything to CIPA.</div>\n    </div></details></div>\n  ","servicesmarketplace":"\n  <div class=\"market-v257-hero card\">\n    <div class=\"market-v257-copy\">\n      <div class=\"kpi\">Thebe Market · trusted business support</div>\n      <h2>Get specialist help without leaving your workspace.</h2>\n      <p class=\"muted\">Start with the service you need. Thebe keeps the request, evidence and order status together while regulated work stays with appropriately authorised professionals.</p>\n      <div class=\"row market-v257-actions\"><button type=\"button\" class=\"btn market-v257-start\" data-bw-onclick=\"focusMarketServices()\">Start here</button><button type=\"button\" class=\"btn soft\" data-bw-onclick=\"focusMarketOrders()\">My orders</button></div>\n    </div>\n    <div class=\"market-v257-visual\" aria-label=\"Thebe Market connects business owners with governed professional support\">\n      <div class=\"market-v257-signal\"><b>Workspace connected</b><span>Request → evidence → professional review</span></div>\n    </div>\n  </div>\n  <div class=\"market-v257-stats\" aria-label=\"Market activity\">\n    <div><span>Services</span><b id=\"serviceCatalogCount\">0</b></div>\n    <div><span>Open</span><b id=\"serviceOpenOrders\">0</b></div>\n    <div><span>In review</span><b id=\"serviceInReview\">0</b></div>\n    <div><span>Completed</span><b id=\"serviceCompleted\">0</b></div>\n  </div>\n  <div class=\"grid g2 market-v257-body\">\n    <div class=\"card\">\n      <div class=\"between row\"><div><div class=\"kpi\">Start here</div><h2>Professional services</h2></div></div>\n      <div id=\"serviceCatalogList\" class=\"grid g2\"></div>\n      <details class=\"market-v257-boundary\"><summary>Professional-service boundary · Tax-service delivery boundary verified</summary><div class=\"small muted\">Thebe Desk is the workflow and evidence platform. Tax-return preparation, tax objections, BURS representation and other regulated professional work must be delivered by an appropriately authorised professional or registered tax agent with explicit client authority. Paid service orders do not bypass that requirement.</div></details>\n    </div>\n    <div class=\"card\">\n      <div class=\"kpi\">Track work</div><h2>Your service orders</h2>\n      <div id=\"serviceOrderList\" class=\"muted small\">No service orders yet.</div>\n    </div>\n  </div>\n","regulatoryobligations":"\n  <div class=\"grid g4\">\n    <div class=\"card\"><div class=\"kpi\">Open obligations</div><div class=\"score\" id=\"regObligationOpen\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Due soon</div><div class=\"score\" id=\"regObligationDueSoon\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">In review</div><div class=\"score\" id=\"regObligationReview\">0</div></div>\n    <div class=\"card\"><div class=\"kpi\">Completed</div><div class=\"score\" id=\"regObligationCompleted\">0</div></div>\n  </div>\n  <div class=\"grid g2\" style=\"margin-top:16px\">\n    <div class=\"card\"><h2>Regulatory obligations</h2><div id=\"regObligationList\" class=\"muted small\">No obligations yet.</div></div>\n    <div class=\"card\"><h2>Rule applicability</h2><div id=\"regApplicabilityList\" class=\"muted small\">No evaluations yet.</div></div>\n  </div>\n"}}