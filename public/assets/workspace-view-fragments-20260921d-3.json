{"schema":2,"shard":3,"views":{"employer":"\n    <div class=\"grid g3\">\n      <div class=\"card\"><div class=\"kpi\">Employees</div><div class=\"score\" id=\"employeeCount\">8</div></div>\n      <div class=\"card\"><div class=\"kpi\">Missing employee evidence</div><div class=\"score bad\" id=\"employeeGaps\">3</div></div>\n      <div class=\"card\"><div class=\"kpi\">Employment risk</div><div class=\"score warn\" style=\"font-size:28px\">MEDIUM</div></div>\n    </div>\n    <div class=\"grid g2\" style=\"margin-top:16px\">\n      <div class=\"card\">\n        <h2>Start protected workflow</h2>\n        <div class=\"grid g2\">\n          <button type=\"button\" class=\"btn alt\" data-bw-onclick=\"startWorkflow('Absence / AWOL')\">Absence / AWOL</button>\n          <button type=\"button\" class=\"btn alt\" data-bw-onclick=\"startWorkflow('Poor performance')\">Poor performance</button>\n          <button type=\"button\" class=\"btn alt\" data-bw-onclick=\"startWorkflow('Misconduct')\">Misconduct</button>\n          <button type=\"button\" class=\"btn alt\" data-bw-onclick=\"startWorkflow('Asset damage/loss')\">Asset damage/loss</button>\n          <button type=\"button\" class=\"btn alt\" data-bw-onclick=\"startWorkflow('Salary advance/deduction')\">Salary advance/deduction</button>\n          <button type=\"button\" class=\"btn alt\" data-bw-onclick=\"startWorkflow('Termination review')\">Termination review</button>\n        </div>\n        <div id=\"workflowOutput\" style=\"margin-top:14px\"></div>\n        <div style=\"margin-top:18px\">\n          <h3>Active HR cases</h3>\n          <div id=\"caseList\"></div>\n        </div>\n      </div>\n      <div class=\"card\"><h2>Employee file health</h2><div id=\"employeeFiles\"></div></div>\n    </div>\n  ","changes":"\n    <div class=\"card\"><h2>Law & regulatory change feed</h2><div id=\"lawChanges\"></div></div>\n  ","rules":"\n    <div class=\"card\">\n      <div class=\"between row\"><div><h2>Botswana rule library</h2